{
  "_comment": "Brisbane City Council ArcGIS feature layers. filter = 'suburb' uses suburb_field; filter = 'area' intersects the scope suburb polygons.",
  "base_url": "https://services2.arcgis.com/dEKgZETqwmDAh1rP/ArcGIS/rest/services",
  "boundaries": {
    "service": "suburb_boundaries",
    "name_field": "SUBURB_NAME"
  },
  "layers": {
    "lines":              { "service": "Parking_Line_locations",                     "filter": "suburb", "suburb_field": "SUBURB" },
    "signs":              { "service": "Parking_Sign_locations",                     "filter": "suburb", "suburb_field": "SUBURB" },
    "passenger_loading":  { "service": "parking_two_minute_passenger_loading_zones", "filter": "suburb", "suburb_field": "Suburb" },
    "commercial_loading": { "service": "parking_commercial_vehicle_loading_zones",   "filter": "suburb", "suburb_field": "Suburb" },
    "clearways":          { "service": "Parking_Clearways",                          "filter": "area" },
    "disability_parking": { "service": "Disability_permit_parking",                  "filter": "area" }
  }
}
